# ─── 中继服务 ───────────────────────────
RELAY_HOST=0.0.0.0
RELAY_PORT=9800
# TLS 证书（可选，配置后启用 WSS）
# RELAY_TLS_CERT=/certs/fullchain.pem
# RELAY_TLS_KEY=/certs/privkey.pem

# ─── 管理 API ───────────────────────────
RELAY_ADMIN_HOST=127.0.0.1
RELAY_ADMIN_PORT=9801
# 留空表示管理 API 不鉴权；对外暴露时务必设置
RELAY_ADMIN_TOKEN=

# ─── 房间与连接限制 ─────────────────────
RELAY_MAX_ROOMS=1000
RELAY_MAX_MEMBERS=8
RELAY_ROOM_IDLE_TIMEOUT=300
RELAY_MAX_CLIENTS=5000
RELAY_MAX_PER_IP=10
RELAY_MSG_RATE=100

# ─── 心跳与日志 ─────────────────────────
RELAY_HEARTBEAT_TIMEOUT=30000
RELAY_HANDSHAKE_TIMEOUT=10000
RELAY_LOG_LEVEL=info
