{
  "name": "sgi-relay-server",
  "version": "1.0.0",
  "private": true,
  "description": "SGI 中继服务器 — WebSocket 房间、信令与数据转发",
  "scripts": {
    "dev": "tsx src/relay-server/main.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/relay-server/main.js",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx tests/relay-integration.ts"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
